# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in real secrets:  cp .env.prod.example .env.prod
# NEVER commit .env.prod. Generate secrets with:  openssl rand -base64 32

# --- Published port (your reverse proxy / TLS terminator sits in front) ---
# Only the web app is published; point your proxy at it. The API is NOT exposed —
# the web app proxies /api to it internally (Next.js rewrites).
WEB_PORT=3000

# --- Container images (pushed by CI to GHCR) ---
# IMAGE_PREFIX + "/api|/web|/ingestion" : ":" + IMAGE_TAG
# e.g. ghcr.io/ahmedsaed/makhzan  ->  ghcr.io/ahmedsaed/makhzan/api:latest
IMAGE_PREFIX=ghcr.io/OWNER/makhzan
IMAGE_TAG=latest

# --- Postgres ---
POSTGRES_USER=makhzan
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=makhzan
# Host is the compose service name "db"; keep asyncpg driver.
DATABASE_URL=postgresql+asyncpg://makhzan:CHANGE_ME_strong_password@db:5432/makhzan

# --- Meilisearch ---
MEILI_MASTER_KEY=CHANGE_ME_meili_master_key
MEILI_URL=http://search:7700

# --- Redis (Arq queue) ---
REDIS_URL=redis://redis:6379

# --- API ---
API_WORKERS=2
# CORS allow-list. Unused in the default topology (browser hits the API same-origin
# via the web proxy). Only needed if you expose the API directly to other origins.
WEB_ORIGINS=https://makhzan.example.com

# "Report a problem": the secret each sender's address is hashed with for rate
# limiting (the hash is kept 24 hours; the address never). Required: deploy.sh
# refuses to deploy without it, and the API refuses reports. Changing it resets
# every sender's count. Generate with: openssl rand -base64 32
REPORT_IP_SALT=
# How many entries at the right of X-Forwarded-For our own proxies wrote. 1: the
# reverse proxy appends $remote_addr, which must be the visitor. Behind a CDN
# that means the proxy restores it first (nginx real_ip_header with
# set_real_ip_from the CDN's ranges), not a 2 here: docs/DEPLOYMENT.md.
TRUSTED_PROXY_HOPS=1

# --- Web ---
# Browser → API path, baked into the web image at build. Keep "/api": the Next.js
# server rewrites it to the internal API. Only change if you expose the API itself.
NEXT_PUBLIC_API_URL=/api
# Umami website id (stats.merope.dev), baked in at build. Blank = no analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Server-side rewrite target (runtime, internal Docker DNS). Rarely needs changing.
API_INTERNAL_URL=http://api:8000
# The site's public origin, no trailing slash (runtime). Canonical links and the
# product pages' structured data are built from it, never from request headers.
# Required: deploy.sh refuses to deploy without it.
SITE_URL=https://makhzan.merope.dev

# --- Ingestion worker ---
# Hour (UTC) for the daily full re-scrape + reindex.
REFRESH_HOUR=3
# false pauses the daily sweep (the site keeps serving). Survives deploys, unlike
# stopping the container. Restart the ingestion service after changing it.
CRAWL_ENABLED=true
# The crawler's Web Bot Auth signing key (Ed25519), for sources with
# identity = "makhzanbot" (docs/crawler-identity.md). Generate one with
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm --no-deps ingestion python -m worker.botauth keygen
# and paste its MAKHZANBOT_SIGNING_KEY= line here. Read by the ingestion worker
# (to sign requests) and the API (to publish the public key at
# SITE_URL/.well-known/http-message-signatures-directory and sign that response,
# which must be signed fresh by every key it lists). Blank = makhzanbot requests
# go out unsigned and the directory answers 404. Never commit it, here or in
# the private configuration. Signatures expire in 60 s: keep the clock in sync
# (timedatectl).
MAKHZANBOT_SIGNING_KEY=
# During a key rotation only (docs/DEPLOYMENT.md, "Crawler signing key"): the new
# key, published a week before it signs anything...
MAKHZANBOT_SIGNING_KEY_NEXT=
# ...and the old key, still published for a week after the switch.
MAKHZANBOT_SIGNING_KEY_PREVIOUS=
# The private supplier configuration (sources.toml, crosswalks/), checked out
# separately and mounted into migrate and ingestion. Relative to this directory.
#MAKHZAN_CONFIG_DIR=../makhzan-config
