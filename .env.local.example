# Developer-side settings for the db-pull / db-load helpers. Copy to .env.local
# (git-ignored) and fill in. These are the same variables deploy.yml uses, so if
# the deploy workflow reaches the server, so will `make db-pull`.

# Server hostname or IP.
DEPLOY_HOST=
# SSH user. Default: root
DEPLOY_USER=
# Where the repo lives on the server. Default: ~/Documents/Projects/makhzan
DEPLOY_PATH=~/Documents/Projects/makhzan
