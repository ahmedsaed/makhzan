# Copy to .env and adjust. Used by docker-compose and the apps.

# --- Postgres ---
POSTGRES_USER=makhzan
POSTGRES_PASSWORD=makhzan
POSTGRES_DB=makhzan
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://makhzan:makhzan@db:5432/makhzan

# --- Meilisearch ---
MEILI_MASTER_KEY=dev-master-key-change-me
MEILI_URL=http://search:7700

# --- Redis (Arq queue for ingestion worker) ---
REDIS_URL=redis://redis:6379

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
