# Copy to .env beside compose.yml and fill in. No secrets here: the tokens are files.

# The folder holding compose.yml, this .env, home-kev.toml, home-pplx.toml, models.ini,
# llamacpp-guard.sh and the two token files (home-kev.token, home-pplx.token), as an absolute path.
WORKER_DIR=/srv/makhzan-ai
# A Hugging Face home whose hub/ holds the pinned snapshots as real files (rsync -L),
# mounted read-only at /models.
WEIGHTS_DIR=/srv/makhzan-ai-weights
# The user the containers run as (`id -u`, `id -g`): it must be able to read the weights,
# the TOMLs and the tokens.
UID=1000
GID=1000
# The broker, as the proxy reaches it: its Tailscale address and port, an IP, never a name.
BROKER_TARGET=<broker tailscale ip>:8100

# Optional: the workers' internal network and the proxy's address on it, if this subnet is
# already used on the machine (the proxy listens on that address only). Move all three
# together: BROKER_NET_DYNAMIC is the part of the subnet Docker gives the workers, and
# PROXY_ADDRESS must be in the subnet but outside it, or a worker can take it first.
# BROKER_NET_SUBNET=10.231.89.0/24
# BROKER_NET_DYNAMIC=10.231.89.128/25
# PROXY_ADDRESS=10.231.89.2

# Optional: pin an image instead of latest, for example to roll back to an older build.
# The default is the slim llama.cpp worker, worker-llamacpp:latest, for both workers and the proxy.
# KEV_IMAGE=ghcr.io/ahmedsaed/makhzan/worker-llamacpp:sha-<commit>
# PPLX_IMAGE=ghcr.io/ahmedsaed/makhzan/worker-llamacpp:sha-<commit>
# A rollback to torch (README.md): kev-worker-cpu / pplx-worker-cpu, which CI still publishes.
# KEV_IMAGE=ghcr.io/ahmedsaed/makhzan/kev-worker-cpu:latest
# PPLX_IMAGE=ghcr.io/ahmedsaed/makhzan/pplx-worker-cpu:latest

# The llama.cpp router on the AMD card (production since 2026-11-27; README.md): the host's
# group ids that may open /dev/dri, from `getent group render video`. Required. Both GGUFs go in
# WEIGHTS_DIR: Kev-4B-Q4_K_M.gguf and pplx-flash-v1.3-Q4_K_S.gguf.
RENDER_GID=
VIDEO_GID=
