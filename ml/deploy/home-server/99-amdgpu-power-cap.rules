# Caps the home server's AMD card (RX 470/570 4 GB) at 65 W whenever its sensor appears (every boot).
#
# Why: the card is fed from the original 320 W power supply through a SATA-to-PCIe adapter. At the
# stock 85 W a sustained Kev run hard-reset the whole server (twice, 2026-11-26, no log, at normal
# temperatures); at 65 W it ran all 1,800 Phase E requests (2 h 54 min) cleanly
# (docs/ai/kev-llamacpp.md). The cap limits average power; brief spikes still reach ~90 W, so this
# is a stopgap until the card has a supply with a native PCIe cable. The fan stays on automatic.
#
# A udev rule, not a systemd unit: amdgpu loads when udev finds the card, so a boot-time unit can
# run before the sensor exists and leave the card at 85 W. This fires when the hwmon is added.
#
# Install (root):
#   sudo cp 99-amdgpu-power-cap.rules /etc/udev/rules.d/
#   sudo udevadm control --reload && sudo udevadm trigger --subsystem-match=hwmon --action=add
# Check:  cat /sys/class/drm/card*/device/hwmon/hwmon*/power1_cap   # 65000000
# Undo:   sudo rm /etc/udev/rules.d/99-amdgpu-power-cap.rules (the cap stays until a reboot)
ACTION=="add", SUBSYSTEM=="hwmon", ATTR{name}=="amdgpu", ATTR{power1_cap}="65000000"
