#!/usr/bin/env bash
# Everyday production actions in one place.
#
#   ./makhzan status         # containers, health, crawl flag, crawler progress
#   ./makhzan freshness [--days N]  # requests, staleness, changes found (read-only)
#   ./makhzan deploy         # update, pull images, migrate, restart (deploy.sh)
#   ./makhzan crawl off|on [--note ..]  # pause / resume the daily crawl (database flag)
#   ./makhzan shop [pause|resume ID [--note ..]]  # pause one shop, surviving syncs and deploys
#   ./makhzan admin password  # set the admin dashboard's password (docs/admin.md)
#   ./makhzan logs [service] # follow logs (default: ingestion)
#   ./makhzan stop|start [service]   # whole stack, or one service
#   ./makhzan backup|migrate
#   ./makhzan restore FILE [--yes] # replace the database with a backup (restore-db.sh)
#   ./makhzan retire SOURCE [--yes] # remove a source and its listings (dry run without --yes)
#   ./makhzan probe [--source ID]   # ask each shop how it answers each crawler identity
#   ./makhzan reports [list|show ID|accept ID..|reject ID..]  # review "Report a problem"
#   ./makhzan overrides [list|add A B --kind never|must --note ..|remove ID..]  # grouping rulings
#   ./makhzan categories-seen [--source ID] [--conflicts-only]  # products in several shop categories
#   ./makhzan ai [status|worker add|list|revoke|admin-token|mode|redecide|revoke|backlog|jobs|flags]
#   ./makhzan ai import DIR [--dry-run|--verify]   # DIR where you typed it; copied to the worker
#                            # AI matching (worker/ai.py, docs/ai/broker-api.md)
#
# Run it on the server, or from a laptop: without a .env.prod here it re-runs
# itself on DEPLOY_HOST over SSH, using the same .env.local variables as
# db-pull.sh. Either way the commands act on the server's stack.
set -euo pipefail
# backup/restore resolve relative paths against where you ran this from.
export MAKHZAN_CALLER_PWD="$PWD"
cd "$(dirname "$0")"

usage() {
  sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

[ $# -gt 0 ] || usage 1
case "$1" in -h|--help|help) usage ;; esac

# --- Not on the server: forward over SSH --------------------------------------
if [ ! -f .env.prod ]; then
  if [ -f .env.local ]; then
    set -a
    # shellcheck disable=SC1091
    . ./.env.local
    set +a
  fi
  : "${DEPLOY_HOST:?no .env.prod here, so this is not the server; set DEPLOY_HOST (e.g. in .env.local) to run it there}"
  DEPLOY_USER="${DEPLOY_USER:-ahmed}"
  DEPLOY_PATH="${DEPLOY_PATH:-~/Documents/Projects/makhzan}"
  if [ "${1:-}" = ai ] && [ "${2:-}" = import ]; then
    # The scores are files on this laptop: copied to the server first, never
    # looked up there by the same name (scripts/lib/ai_import.sh).
    . scripts/lib/ops.sh
    . scripts/lib/ai_import.sh
    shift 2
    ai_import_remote "${DEPLOY_USER}@${DEPLOY_HOST}" "${DEPLOY_PATH}" "$@"
    exit $?
  fi
  # -t so `logs` can be interrupted and colours survive. The path is left
  # unquoted on purpose so the remote shell expands a leading ~.
  exec ssh -t "${DEPLOY_USER}@${DEPLOY_HOST}" "cd ${DEPLOY_PATH} && ./makhzan $(printf '%q ' "$@")"
fi

# --- On the server ------------------------------------------------------------
. scripts/lib/ops.sh
ops_production_only
COMPOSE=(docker compose -f docker-compose.prod.yml --env-file .env.prod)

# What the running worker actually believes, which is not necessarily what
# .env.prod says: the worker reads it only when its container is (re)created.
crawl_effective() {
  "${COMPOSE[@]}" exec -T ingestion python -c \
    "import worker.main as m; print('on' if m.CRAWL_ENABLED else 'off')" 2>/dev/null \
    || echo "unknown (worker not running, or its image predates CRAWL_ENABLED)"
}

crawl_configured() {
  local v
  v="$(sed -n 's/^CRAWL_ENABLED=//p' .env.prod | tail -1)"
  echo "${v:-true (unset)}"
}

cmd_status() {
  echo "==> Checkout: $(git log -1 --format='%h %s (%cr)')"
  echo
  echo "==> Containers"
  "${COMPOSE[@]}" ps
  echo

  set -a; . ./.env.prod; set +a
  local port="${WEB_PORT:-3000}"
  if curl -fsS --max-time 5 "http://localhost:${port}/api/health" >/dev/null 2>&1; then
    echo "==> Health: /api/health answers"
  else
    echo "==> Health: /api/health on localhost:${port} is NOT answering"
  fi
  echo
  echo "==> Crawl: worker says $(crawl_effective); .env.prod says CRAWL_ENABLED=$(crawl_configured)"
  "${COMPOSE[@]}" exec -T ingestion python -m worker.pause crawl 2>/dev/null | sed 's/^/    /' || true
  local admin="${ADMIN_BIND:-127.0.0.1:8200}"
  if curl -fsS --max-time 5 -o /dev/null "http://${admin}/login" 2>/dev/null; then
    echo "==> Admin dashboard: answers on ${admin}"
  else
    echo "==> Admin dashboard: http://${admin}/login is NOT answering"
  fi
  local broker="${BROKER_BIND:-127.0.0.1:8100}"
  if curl -fsS --max-time 5 "http://${broker}/ai/v1/health" >/dev/null 2>&1; then
    echo "==> AI broker: /ai/v1/health answers on ${broker}"
  else
    echo "==> AI broker: /ai/v1/health on ${broker} is NOT answering"
  fi
  echo

  # The report is in the image (worker/status.py), shared with the admin
  # dashboard; the container has .env.prod's connection details.
  "${COMPOSE[@]}" exec -T ingestion python -m worker.status "$@"
}

# Like status.py, streamed in from the checkout; it opens a READ ONLY
# transaction and rolls it back, so it can change nothing.
cmd_freshness() {
  "${COMPOSE[@]}" exec -T ingestion python - "$@" < scripts/freshness.py
}

# AI matching by hand (apps/ingestion/worker/ai.py). `admin-token` is the one
# that needs the host: the broker keeps only the token's sha256, in .env.prod,
# and reads it when its container is created, so a new token replaces the old
# one by rewriting that line and recreating the broker. The token is shown once.
cmd_ai() {
  if [ "${1:-}" = "import" ]; then
    # The scores are files on this machine, copied into a fresh folder in the
    # worker container and removed afterwards (scripts/lib/ai_import.sh).
    . scripts/lib/ai_import.sh
    shift
    ai_import_local "$@"
    return
  fi
  if [ "${1:-}" != "admin-token" ]; then
    "${COMPOSE[@]}" exec -T ingestion python -m worker.ai "$@"
    return
  fi
  local out token hash
  out="$("${COMPOSE[@]}" exec -T ingestion python -m worker.ai admin-token)"
  token="$(sed -n 's/^token=//p' <<<"$out")"
  hash="$(sed -n 's/^sha256=//p' <<<"$out")"
  if [ -z "$token" ] || [ -z "$hash" ]; then
    echo "could not make an admin token" >&2
    exit 1
  fi
  if grep -q '^AI_BROKER_ADMIN_TOKEN_SHA256=' .env.prod; then
    sed -i "s/^AI_BROKER_ADMIN_TOKEN_SHA256=.*/AI_BROKER_ADMIN_TOKEN_SHA256=${hash}/" .env.prod
  else
    printf '\nAI_BROKER_ADMIN_TOKEN_SHA256=%s\n' "$hash" >> .env.prod
  fi
  "${COMPOSE[@]}" up -d --force-recreate --no-deps broker
  echo "==> New admin token for GET /ai/v1/status (shown once; the previous one no longer works):"
  echo "$token"
}

cmd_crawl() {
  case "${1:-}" in
    on|off) ;;
    "") echo "Crawl: worker says $(crawl_effective); .env.prod says CRAWL_ENABLED=$(crawl_configured)"
        "${COMPOSE[@]}" exec -T ingestion python -m worker.pause crawl; return ;;
    *) echo "usage: makhzan crawl [on|off] [--note why]" >&2; exit 1 ;;
  esac

  # The pause is a database flag (worker_state "crawl_pause", worker/pause.py),
  # the same one the admin dashboard flips: the worker reads it before every
  # daily job and every page of a full run, so nothing is recreated and a run
  # in flight stops at its next page, cursors kept.
  # Not fatal: for `on`, the .env.prod switch below must still be cleared when
  # the worker is down (it is often down precisely because the crawl was off).
  local paused_ok=0
  "${COMPOSE[@]}" exec -T ingestion python -m worker.pause crawl "$@" --by "$(id -un)" \
    || paused_ok=$?

  # CRAWL_ENABLED in .env.prod is the older, harder switch: read only when the
  # worker's container is created. `on` clears it too, so `on` always means on.
  # Every value the worker reads as off (makhzan_schemas.crawl.crawl_enabled:
  # 0, false, no, off, any case, spaces around) counts.
  if [ "$1" = on ] && grep -qiE '^CRAWL_ENABLED=[[:space:]]*(0|false|no|off)[[:space:]]*$' .env.prod; then
    # I: the key was matched case-insensitively above; rewrite it the same way.
    sed -i "s/^CRAWL_ENABLED=.*/CRAWL_ENABLED=true/I" .env.prod
    echo "==> .env.prod had CRAWL_ENABLED off; set it true and recreating the ingestion worker"
    "${COMPOSE[@]}" up -d --force-recreate --no-deps ingestion
    echo "==> Worker now says: $(crawl_effective)"
    if [ "$paused_ok" -ne 0 ]; then
      # The worker is up now: clear the database pause too.
      "${COMPOSE[@]}" exec -T ingestion python -m worker.pause crawl on --by "$(id -un)" \
        && paused_ok=0
    fi
  fi
  if [ "$paused_ok" -ne 0 ]; then
    echo "could not set the database pause (is the ingestion worker running?)" >&2
    exit "$paused_ok"
  fi
}

# Append a line to .env.prod, after a newline if the file does not end in one:
# otherwise the new line would be glued onto the last setting.
env_append() {
  if [ -s .env.prod ] && [ "$(tail -c1 .env.prod | od -An -c | tr -d ' ')" != '\n' ]; then
    printf '\n' >> .env.prod
  fi
  printf '%s\n' "$1" >> .env.prod
}

# One shop's pause (sources.paused_at, worker/pause.py), over sources.toml's
# `enabled`; the sync never writes it, so it survives deploys.
cmd_shop() {
  if [ $# -eq 0 ]; then
    "${COMPOSE[@]}" exec -T ingestion python -m worker.pause shop
  else
    "${COMPOSE[@]}" exec -T ingestion python -m worker.pause shop "$@" --by "$(id -un)"
  fi
}

# The admin dashboard's password (docs/admin.md). Asked here, twice, hashed in
# the container (scrypt; the password is never written anywhere), and the hash
# written into .env.prod with, the first time, the session secret. Recreating
# the admin service ends every session.
cmd_admin() {
  if [ "${1:-}" != password ]; then
    echo "usage: makhzan admin password" >&2
    exit 1
  fi
  local pw pw2 out
  # IFS= keeps leading and trailing spaces: the password is exactly what was typed.
  IFS= read -rsp "New admin password: " pw; echo
  IFS= read -rsp "Again: " pw2; echo
  if [ "$pw" != "$pw2" ]; then echo "The two did not match." >&2; exit 1; fi
  local secret_flag=()
  grep -q '^ADMIN_SECRET=.\+' .env.prod || secret_flag=(--secret)
  out="$(printf '%s' "$pw" | "${COMPOSE[@]}" run --rm --no-deps -T admin python -m admin.password --stdin "${secret_flag[@]}")" || exit 1
  unset pw pw2
  local line key
  while IFS= read -r line; do
    key="${line%%=*}"
    case "$key" in ADMIN_PASSWORD_HASH|ADMIN_SECRET) ;; *) continue ;; esac
    if grep -q "^${key}=" .env.prod; then
      sed -i "s|^${key}=.*|${line}|" .env.prod
    else
      env_append "$line"
    fi
  done <<<"$out"
  "${COMPOSE[@]}" up -d --force-recreate --no-deps admin
  echo "==> Admin password set; the dashboard was recreated (existing sessions ended)."
}

cmd="$1"; shift
case "$cmd" in
  status) cmd_status "$@" ;;
  freshness) cmd_freshness "$@" ;;
  deploy) exec ./scripts/deploy.sh "$@" ;;
  crawl) cmd_crawl "$@" ;;
  shop) cmd_shop "$@" ;;
  admin) cmd_admin "$@" ;;
  logs) "${COMPOSE[@]}" logs -f --tail 200 "${@:-ingestion}" ;;
  stop) "${COMPOSE[@]}" stop "$@" ;;
  start) "${COMPOSE[@]}" up -d "$@" ;;
  backup) exec ./scripts/backup-db.sh "$@" ;;
  restore) exec ./scripts/restore-db.sh "$@" ;;
  migrate) exec ./scripts/migrate.sh ;;
  retire) "${COMPOSE[@]}" exec -T ingestion python -m worker.sources.retire "$@" ;;
  # The crawler's own client, in the ingestion image; run it while no crawl is
  # running, since its 15 s per-host gap is its own, not the worker's.
  probe) exec ./scripts/probe-suppliers.sh "$@" ;;
  # Visitors' reports from product pages: the list shows each with what the
  # page showed then; accept/reject set status and reviewed_at (worker/reports.py).
  reports) "${COMPOSE[@]}" exec -T ingestion python -m worker.reports "$@" ;;
  # Grouping rulings: two listings never, or always, one product (worker/overrides.py).
  # Accepting a grouping report writes them too; a regroup applies them.
  overrides) "${COMPOSE[@]}" exec -T ingestion python -m worker.overrides "$@" ;;
  # Every shop category a product appeared under in the last completed cycle,
  # for products listed under several (worker/categories_seen.py). Read-only.
  categories-seen) "${COMPOSE[@]}" exec -T ingestion python -m worker.categories_seen "$@" ;;
  # AI matching: workers' tokens, the admin token, the mode, decisions, the backlog.
  ai) cmd_ai "$@" ;;
  *) echo "unknown command: $cmd" >&2; usage 1 ;;
esac
